app("Calculator") {
    state display = 0
    state stored = 0
    state op = ""
    state fresh = true

    Window {
        title("Calculator")
        size(320, 420)

        Column {
            spacing(8)
            padding(16)

            Text(display)

            Row {
                spacing(8)

                Button("7") {
                    on_click {
                        if fresh {
                            display = 7
                            fresh = false
                        } else {
                            display = display * 10 + 7
                        }
                    }
                }

                Button("8") {
                    on_click {
                        if fresh {
                            display = 8
                            fresh = false
                        } else {
                            display = display * 10 + 8
                        }
                    }
                }

                Button("9") {
                    on_click {
                        if fresh {
                            display = 9
                            fresh = false
                        } else {
                            display = display * 10 + 9
                        }
                    }
                }

                Button("/") {
                    on_click {
                        if op == "+" {
                            display = stored + display
                        } else if op == "-" {
                            display = stored - display
                        } else if op == "*" {
                            display = stored * display
                        } else if op == "/" {
                            if display == 0 {
                                display = 0
                            } else {
                                display = stored / display
                            }
                        }
                        stored = display
                        op = "/"
                        fresh = true
                    }
                }
            }

            Row {
                spacing(8)

                Button("4") {
                    on_click {
                        if fresh {
                            display = 4
                            fresh = false
                        } else {
                            display = display * 10 + 4
                        }
                    }
                }

                Button("5") {
                    on_click {
                        if fresh {
                            display = 5
                            fresh = false
                        } else {
                            display = display * 10 + 5
                        }
                    }
                }

                Button("6") {
                    on_click {
                        if fresh {
                            display = 6
                            fresh = false
                        } else {
                            display = display * 10 + 6
                        }
                    }
                }

                Button("*") {
                    on_click {
                        if op == "+" {
                            display = stored + display
                        } else if op == "-" {
                            display = stored - display
                        } else if op == "*" {
                            display = stored * display
                        } else if op == "/" {
                            if display == 0 {
                                display = 0
                            } else {
                                display = stored / display
                            }
                        }
                        stored = display
                        op = "*"
                        fresh = true
                    }
                }
            }

            Row {
                spacing(8)

                Button("1") {
                    on_click {
                        if fresh {
                            display = 1
                            fresh = false
                        } else {
                            display = display * 10 + 1
                        }
                    }
                }

                Button("2") {
                    on_click {
                        if fresh {
                            display = 2
                            fresh = false
                        } else {
                            display = display * 10 + 2
                        }
                    }
                }

                Button("3") {
                    on_click {
                        if fresh {
                            display = 3
                            fresh = false
                        } else {
                            display = display * 10 + 3
                        }
                    }
                }

                Button("-") {
                    on_click {
                        if op == "+" {
                            display = stored + display
                        } else if op == "-" {
                            display = stored - display
                        } else if op == "*" {
                            display = stored * display
                        } else if op == "/" {
                            if display == 0 {
                                display = 0
                            } else {
                                display = stored / display
                            }
                        }
                        stored = display
                        op = "-"
                        fresh = true
                    }
                }
            }

            Row {
                spacing(8)

                Button("0") {
                    on_click {
                        if fresh {
                            display = 0
                            fresh = false
                        } else {
                            display = display * 10 + 0
                        }
                    }
                }

                Button("C") {
                    on_click {
                        display = 0
                        stored = 0
                        op = ""
                        fresh = true
                    }
                }

                Button("=") {
                    on_click {
                        if op == "+" {
                            display = stored + display
                        } else if op == "-" {
                            display = stored - display
                        } else if op == "*" {
                            display = stored * display
                        } else if op == "/" {
                            if display == 0 {
                                display = 0
                            } else {
                                display = stored / display
                            }
                        }
                        op = ""
                        fresh = true
                    }
                }

                Button("+") {
                    on_click {
                        if op == "+" {
                            display = stored + display
                        } else if op == "-" {
                            display = stored - display
                        } else if op == "*" {
                            display = stored * display
                        } else if op == "/" {
                            if display == 0 {
                                display = 0
                            } else {
                                display = stored / display
                            }
                        }
                        stored = display
                        op = "+"
                        fresh = true
                    }
                }
            }
        }
    }
}
